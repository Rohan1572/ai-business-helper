{
  "name": "ai-business-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "1.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "reinstall": "node -e \"const fs = require('fs'); for (const path of ['node_modules', 'dist', 'coverage', 'package-lock.json']) fs.rmSync(path, { recursive: true, force: true })\" && npm install",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "10.0.0",
    "globals": "15.15.0",
    "prettier": "3.8.1",
    "vite": "6.4.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
